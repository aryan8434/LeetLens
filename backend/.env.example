PORT=5000

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Razorpay (REQUIRED for payments). No hardcoded fallbacks exist any more —
# payment endpoints return 503 until these are set. Get them from the Razorpay
# dashboard. Rotate the secret if it was ever committed to source control.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Required for POST /api/razorpay-webhook signature verification.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Comma-separated list of browser origins allowed to call this API via CORS.
# Defaults to the production + localhost origins if unset.
ALLOWED_ORIGINS=https://leetlens.tech,https://www.leetlens.tech,http://localhost:5173,http://localhost:3000

# Firebase Admin service account, as a single-line JSON string.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"leetlens", ...}
